# Local E2E output can contain multi-gigabyte evidence and must never enter an
# extension package or source-control changeset.
dashbridge-e2e-diagnostics-*.json

# Generated test/runtime caches are never extension assets.
__pycache__/
.pytest_cache/
*.py[cod]

# Traffic recordings contain request/response bodies, credentials and tokens.
*.dashflow

# Release archives are reproducible GitHub Actions artifacts.
dist/

# Development-only analysis and browser smoke dependencies/artifacts.
node_modules/
test-results/
.worktrees/

# Persistent Playwright profiles contain cookies, local storage and auth state.
# Keep the canonical local profile inside the project for sandbox reliability,
# but never include it in Git, release archives or extension package checks.
.dashbridge-local/

# Local analytics preview data and deployment credentials never enter Git.
deploy/dashbridge-analytics/.dev-data/
deploy/dashbridge-analytics/.dev-data-*/
.deploy-keys/
.analytics-deploy.json

# Keep only maintained project documentation in Git. Draft plans and audit
# journals may remain locally, but require an explicit allowlist change to publish.
/docs/*
!/docs/README.md
!/docs/architecture.md
!/docs/development-guide.md
!/docs/module-design.md
!/docs/permission-map.md
!/docs/dashflow-v2.md
!/docs/installer.md
!/docs/analytics.md
!/docs/roadmap.md
!/docs/testing.md
!/docs/history/
/docs/history/*
!/docs/history/architecture-decisions.md
