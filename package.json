{
  "name": "dashbridge-development",
  "version": "2.5.0",
  "private": true,
  "description": "Development-only analysis and browser verification for the DashBridge extension.",
  "scripts": {
    "auth:grafana": "node scripts/setup-grafana-e2e-profile.js",
    "browser:install": "playwright install chromium",
    "check:grafana-session": "node scripts/check-grafana-e2e-session.js",
    "test:live:check": "node test/live/live-session-check.js",
    "test:live:scenario": "node test/live/run-live-scenario.js",
    "test:live:smoke": "node test/live/run-live-smoke.js",
    "test:live:matrix": "node test/live/run-live-matrix.js",
    "lint": "eslint .",
    "test:unit": "node test/run-all-tests.js",
    "test:browser": "node test/run-extension-browser-smoke.js",
    "test:grafana:live": "node scripts/run-live-grafana-e2e.js",
    "test:all": "npm run lint && npm run test:unit && npm run test:browser"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "10.9.1"
  }
}
